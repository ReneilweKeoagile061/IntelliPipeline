{
  "buildCommand": "cd dashboard && npm run build",
  "installCommand": "cd dashboard && npm install",
  "outputDirectory": "dashboard/dist",
  "framework": "vite",
  "functions": {
    "api/app.py": { "runtime": "@vercel/python@4.3.0" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}