{
  "services": {
    "dashboard": {
      "root": "dashboard",
      "framework": "vite"
    },
    "api": {
      "entrypoint": "api/app.py"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/((?!api/).*)", "destination": { "service": "dashboard" } }
  ]
}