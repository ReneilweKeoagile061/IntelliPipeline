{
  "services": {
    "dashboard": {
      "root": "dashboard/",
      "framework": "vite"
    },
    "api": {
      "root": "api/",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}